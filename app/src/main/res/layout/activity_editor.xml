<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/editorHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/foreground"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/field_type"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />

        <GridLayout
            android:id="@+id/typeGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:columnCount="3"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/customIconSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/field_icon"
                android:textColor="@color/secondary_text"
                android:textSize="13sp" />

            <GridLayout
                android:id="@+id/iconGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:columnCount="4"
                android:orientation="horizontal" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/field_title"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/titleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/control_surface"
            android:gravity="center_vertical"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:minHeight="54dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/foreground"
            android:textColorHint="@color/secondary_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/field_date"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/dateButton"
            style="@style/Widget.CountAway.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/field_reminder"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/control_surface">

            <Spinner
                android:id="@+id/reminderSpinner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@android:color/transparent"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:spinnerMode="dropdown" />
        </FrameLayout>

        <Button
            android:id="@+id/saveButton"
            style="@style/Widget.CountAway.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/action_save" />

        <Button
            android:id="@+id/deleteButton"
            style="@style/Widget.CountAway.Button.Destructive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/action_delete" />

    </LinearLayout>
</ScrollView>
