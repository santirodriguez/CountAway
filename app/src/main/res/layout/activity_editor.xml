<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/editorHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/foreground"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/typeLabel"
            style="@style/Widget.CountAway.EditorLabel"
            android:text="@string/field_type" />

        <GridLayout
            android:id="@+id/typeGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:columnCount="3"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/presetPreservedNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/secondary_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/titleLabel"
            style="@style/Widget.CountAway.EditorLabel"
            android:labelFor="@id/titleInput"
            android:text="@string/field_title" />

        <EditText
            android:id="@+id/titleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/control_surface"
            android:gravity="center_vertical"
            android:importantForAutofill="no"
            android:saveEnabled="false"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="2"
            android:minHeight="52dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/foreground"
            android:textColorHint="@color/secondary_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/modeLabel"
            style="@style/Widget.CountAway.EditorLabel"
            android:labelFor="@id/modeButton"
            android:text="@string/count_mode_label" />

        <Button
            android:id="@+id/modeButton"
            style="@style/Widget.CountAway.EditorControl"
            android:text="@string/count_mode_down" />

        <TextView
            android:id="@+id/dateLabel"
            style="@style/Widget.CountAway.EditorLabel"
            android:labelFor="@id/dateButton"
            android:text="@string/field_date" />

        <Button
            android:id="@+id/dateButton"
            style="@style/Widget.CountAway.EditorControl" />

        <LinearLayout
            android:id="@+id/repeatSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.CountAway.EditorLabel"
                android:text="@string/field_repeat"
                android:labelFor="@id/repeatSpinner" />

            <Spinner
                android:id="@+id/repeatSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="52dp"
                android:background="@drawable/control_surface"
                android:foreground="?android:attr/selectableItemBackground"
                android:popupBackground="@color/surface"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reminderSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.CountAway.EditorLabel"
                android:text="@string/field_reminder"
                android:labelFor="@id/reminderSpinner" />

            <Spinner
                android:id="@+id/reminderSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="52dp"
                android:background="@drawable/control_surface"
                android:foreground="?android:attr/selectableItemBackground"
                android:popupBackground="@color/surface"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <TextView
            android:id="@+id/editorScheduleSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/secondary_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/customIconSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Widget.CountAway.EditorLabel"
                android:labelFor="@id/iconButton"
                android:text="@string/field_icon" />

            <Button
                android:id="@+id/iconButton"
                style="@style/Widget.CountAway.EditorControl" />
        </LinearLayout>

        <Button
            android:id="@+id/saveButton"
            style="@style/Widget.CountAway.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/action_save" />

        <Button
            android:id="@+id/shareButton"
            style="@style/Widget.CountAway.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_share" />

        <Button
            android:id="@+id/deleteButton"
            style="@style/Widget.CountAway.Button.Destructive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_delete" />
    </LinearLayout>
</ScrollView>
