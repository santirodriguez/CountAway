<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/languageButton"
            style="@style/Widget.CountAway.Button.Secondary"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:background="@drawable/icon_button"
            android:gravity="center"
            android:contentDescription="@string/language_choose"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/themeButton"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:minHeight="48dp"
            android:background="@drawable/icon_button"
            android:contentDescription="@string/theme_switch_to_light"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="☀"
            android:textColor="@color/foreground"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/aboutButton"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/icon_button"
            android:contentDescription="@string/action_about"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="i"
            android:textColor="@color/foreground"
            android:textSize="20sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="206dp"
        android:layout_height="134dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_logo_content_description"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/brand_logo" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/countdownList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <ScrollView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/surface_card"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <ImageView
                    android:id="@+id/emptyStateIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/icon_container"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_event_calendar"
                    android:tint="@color/accent" />

                <TextView
                    android:id="@+id/emptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="@string/empty_title"
                    android:textColor="@color/foreground"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/emptyDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/empty_description"
                    android:textColor="@color/secondary_text"
                    android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/homeResetUndoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/surface_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/homeResetUndoMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/foreground"
            android:textSize="14sp" />

        <Button
            android:id="@+id/homeResetUndoButton"
            style="@style/Widget.CountAway.SmallAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="66dp"
            android:text="@string/event_reset_undo_action" />

        <Button
            android:id="@+id/homeResetUndoDismiss"
            style="@style/Widget.CountAway.Dialog.Button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/event_reset_dismiss"
            android:minWidth="48dp"
            android:text="×"
            android:textColor="@color/secondary_text"
            android:textSize="21sp" />
    </LinearLayout>

    <Button
        android:id="@+id/addCountdownButton"
        style="@style/Widget.CountAway.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/action_add_countdown" />

</LinearLayout>
