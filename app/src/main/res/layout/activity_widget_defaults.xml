<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetDefaultsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_defaults_title"
            android:textColor="@color/foreground"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/widget_defaults_description"
            android:textColor="@color/secondary_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/widget_appearance_label"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/control_surface">

            <Spinner
                android:id="@+id/widgetDefaultsAppearanceSpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:spinnerMode="dropdown" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/widget_background_label"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/control_surface">

            <Spinner
                android:id="@+id/widgetDefaultsBackgroundSpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:spinnerMode="dropdown" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/widget_preview_label"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/widgetDefaultsPreviewBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/widgetDefaultsPreviewTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="@string/widget_defaults_preview_title"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/widgetDefaultsPreviewIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="@null"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_event_calendar" />

                <TextView
                    android:id="@+id/widgetDefaultsPreviewCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_value"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widgetDefaultsPreviewUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/widget_days_left"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <Button
            android:id="@+id/widgetDefaultsResetButton"
            style="@style/Widget.CountAway.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/widget_defaults_reset" />

        <Button
            android:id="@+id/widgetDefaultsSaveButton"
            style="@style/Widget.CountAway.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/action_save" />

        <Button
            android:id="@+id/widgetDefaultsCancelButton"
            style="@style/Widget.CountAway.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/action_cancel" />

    </LinearLayout>
</ScrollView>
