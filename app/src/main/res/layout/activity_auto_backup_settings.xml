<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/autoBackupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:id="@+id/autoBackupBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:background="@drawable/icon_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:contentDescription="@string/auto_backup_back"
            android:text="‹"
            android:textSize="28sp"
            android:textColor="@color/foreground" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/auto_backup_title"
            android:textSize="23sp"
            android:textColor="@color/foreground" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/auto_backup_description"
            android:textSize="14sp"
            android:textColor="@color/secondary_text" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/backup_status_surface"
            android:orientation="vertical"
            android:padding="18dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/autoBackupStatusIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_backup_shield"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/autoBackupStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/auto_backup_off"
                    android:textSize="19sp"
                    android:textColor="@color/foreground" />
                <TextView
                    android:id="@+id/autoBackupVerifiedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/backup_verified_pill"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="@string/auto_backup_verified_badge"
                    android:textColor="@color/backup_success"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
            <TextView
                android:id="@+id/autoBackupDestination"
                android:drawableStart="@drawable/ic_backup_folder"
                android:drawablePadding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:text="@string/auto_backup_none"
                android:textColor="@color/secondary_text" />
            <TextView
                android:id="@+id/autoBackupLastVerified"
                android:drawableStart="@drawable/ic_backup_calendar"
                android:drawablePadding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/auto_backup_never"
                android:textSize="13sp"
                android:textColor="@color/secondary_text" />
            <TextView
                android:id="@+id/autoBackupLastAttempt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                android:textColor="@color/secondary_text" />
            <TextView
                android:id="@+id/autoBackupError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:textSize="13sp"
                android:textColor="@color/danger"
                android:visibility="gone" />
            <TextView
                android:id="@+id/autoBackupProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/auto_backup_working"
                android:textSize="13sp"
                android:textColor="@color/accent_text"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:drawableStart="@drawable/ic_backup_folder"
            android:drawablePadding="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/auto_backup_destination_title"
            android:textColor="@color/foreground"
            android:textSize="16sp" />
        <Button
            android:id="@+id/autoBackupDefault"
            android:background="@drawable/backup_folder_choice"
            android:drawableStart="@drawable/ic_backup_folder"
            android:drawablePadding="10dp"
            android:gravity="center_vertical|start"
            android:minHeight="60dp"
            style="@style/Widget.CountAway.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/auto_backup_default" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/auto_backup_default_note"
            android:textSize="12sp"
            android:textColor="@color/secondary_text" />
        <Button
            android:id="@+id/autoBackupChoose"
            android:background="@drawable/backup_folder_choice"
            android:drawableStart="@drawable/ic_backup_folder_plus"
            android:drawablePadding="10dp"
            android:gravity="center_vertical|start"
            android:minHeight="60dp"
            style="@style/Widget.CountAway.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/auto_backup_choose" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/auto_backup_choose_note"
            android:textSize="12sp"
            android:textColor="@color/secondary_text" />
        <Button
            android:id="@+id/autoBackupNow"
            android:drawableStart="@drawable/ic_backup_save"
            android:drawablePadding="8dp"
            style="@style/Widget.CountAway.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/auto_backup_now"
            android:visibility="gone" />
        <Button
            android:id="@+id/autoBackupDisable"
            android:drawableStart="@drawable/ic_backup_power"
            android:drawablePadding="8dp"
            style="@style/Widget.CountAway.Button.Destructive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auto_backup_disable"
            android:visibility="gone" />
        <Button
            android:id="@+id/autoBackupRecover"
            style="@style/Widget.CountAway.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/auto_backup_recover"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/surface_card"
            android:gravity="top"
            android:orientation="horizontal"
            android:padding="14dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_backup_info" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/auto_backup_privacy"
                android:textColor="@color/secondary_text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
