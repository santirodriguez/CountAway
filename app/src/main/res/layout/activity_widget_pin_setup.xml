<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetPinSetupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_pin_setup_title"
            android:textColor="@color/foreground"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/widget_pin_setup_description"
            android:textColor="@color/secondary_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widgetPinSetupEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/status_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="@color/foreground"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/widget_background_label"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/control_surface">

            <Spinner
                android:id="@+id/widgetPinSetupBackgroundSpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:spinnerMode="dropdown" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/widget_appearance_label"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/control_surface">

            <Spinner
                android:id="@+id/widgetPinSetupAppearanceSpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:spinnerMode="dropdown" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/widget_preview_label"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/widgetPinSetupPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="no">

            <FrameLayout
                android:id="@+id/widgetPinSetupPreviewFrame"
                android:layout_width="160dp"
                android:layout_height="100dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <Button
            android:id="@+id/widgetPinSetupAddButton"
            style="@style/Widget.CountAway.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/widget_pin_setup_add" />

        <Button
            android:id="@+id/widgetPinSetupCancelButton"
            style="@style/Widget.CountAway.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/action_cancel" />

    </LinearLayout>
</ScrollView>
