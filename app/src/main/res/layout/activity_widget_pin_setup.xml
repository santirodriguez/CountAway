<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetPinSetupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_pin_setup_title"
            android:textColor="@color/foreground"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/widget_pin_setup_description"
            android:textColor="@color/secondary_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/surface_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/widgetPinSetupEventIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/icon_container"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:tint="@color/accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widgetPinSetupEventTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:textColor="@color/foreground"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/widgetPinSetupEventDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/secondary_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_background_label"
            android:textColor="@color/foreground"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/widgetPinSetupBackgroundRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_appearance_label"
            android:textColor="@color/foreground"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/widgetPinSetupAppearanceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/control_surface"
            android:orientation="horizontal"
            android:padding="6dp">

            <RadioButton
                android:id="@+id/widgetPinSetupAppearanceSystem"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/widget_appearance_system"
                android:textColor="@color/foreground" />

            <RadioButton
                android:id="@+id/widgetPinSetupAppearanceLight"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/widget_appearance_light"
                android:textColor="@color/foreground" />

            <RadioButton
                android:id="@+id/widgetPinSetupAppearanceDark"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/widget_appearance_dark"
                android:textColor="@color/foreground" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/widget_pin_setup_system_hint"
            android:textColor="@color/secondary_text"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/widget_preview_label"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widgetPinSetupStyleSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/secondary_text"
            android:textSize="12sp" />

        <FrameLayout
            android:id="@+id/widgetPinSetupPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="184dp"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="no">

            <FrameLayout
                android:id="@+id/widgetPinSetupPreviewFrame"
                android:layout_width="160dp"
                android:layout_height="100dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <Button
            android:id="@+id/widgetPinSetupAddButton"
            style="@style/Widget.CountAway.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/widget_pin_setup_add" />

        <Button
            android:id="@+id/widgetPinSetupCancelButton"
            style="@style/Widget.CountAway.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/action_cancel" />

    </LinearLayout>
</ScrollView>
