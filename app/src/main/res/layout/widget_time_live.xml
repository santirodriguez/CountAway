<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timeWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/timeWidgetBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/timeWidgetContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/timeWidgetIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_event_calendar"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/timeWidgetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="@color/widget_dark_text"
                android:textSize="14sp"
                android:maxLines="3"
                android:ellipsize="end" />
            <!-- Reserved for a small secondary CountAway mark; the normal widget stays unchanged. -->
            <ImageView
                android:id="@+id/timeWidgetBrandMark"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_marginStart="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_time_brand_mark"
                android:contentDescription="@null"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/timeWidgetLiveDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/widget_time_indicator"
                android:contentDescription="@null" />
        </LinearLayout>

        <ImageView
            android:id="@+id/timeWidgetAccentLine"
            android:layout_width="34dp"
            android:layout_height="3dp"
            android:layout_marginTop="9dp"
            android:alpha="0.85"
            android:scaleType="fitXY"
            android:src="@drawable/widget_time_accent"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/timeWidgetCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_dark_secondary_text"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />

        <Chronometer
            android:id="@+id/timeWidgetClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-condensed"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:gravity="center_vertical"
            android:textStyle="bold"
            android:textSize="43sp"
            android:singleLine="true"
            android:ellipsize="none"
            android:textColor="@color/widget_dark_accent" />

        <TextView
            android:id="@+id/timeWidgetFallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_dark_accent"
            android:textSize="15sp"
            android:maxLines="2"
            android:visibility="gone" />

        <TextView
            android:id="@+id/timeWidgetDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:textColor="@color/widget_dark_secondary_text"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
