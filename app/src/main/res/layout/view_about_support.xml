<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/surface_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:breakStrategy="balanced"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/about_donate_note"
            android:textColor="@color/secondary_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/donateButton"
            style="@style/Widget.CountAway.SmallAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/about_support_project" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="18dp"
            android:background="@color/outline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/about_author_name"
            android:textColor="@color/foreground"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/projectLinksCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/surface_card"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/about_project_links_title"
            android:textColor="@color/foreground"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/projectLinksRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/websiteButton"
                style="@style/Widget.CountAway.SmallAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/about_website" />

            <Button
                android:id="@+id/privacyButton"
                style="@style/Widget.CountAway.SmallAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/about_privacy_policy" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
