<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetConfigRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background">
    <ListView
        android:id="@+id/widgetEventList"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:choiceMode="singleChoice" android:clipToPadding="false"
        android:divider="@android:color/transparent" android:dividerHeight="8dp"
        android:itemsCanFocus="true" />
</FrameLayout>
