<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background_horizon_dark"
        android:contentDescription="@null" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/launcher_foreground_art"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/time_widget_preview_title"
                android:textSize="14sp"
                android:maxLines="2"
                android:textColor="@color/widget_dark_text" />
            <ImageView
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/widget_time_indicator"
                android:tint="@color/widget_dark_accent"
                android:contentDescription="@null" />
        </LinearLayout>
        <ImageView
            android:layout_width="34dp"
            android:layout_height="3dp"
            android:layout_marginTop="9dp"
            android:src="@drawable/widget_time_accent"
            android:tint="@color/widget_dark_accent"
            android:contentDescription="@null" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-condensed"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:text="79:12:05"
            android:textStyle="bold"
            android:textSize="33sp"
            android:textColor="@color/widget_dark_accent" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/time_widget_preview_target"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:textSize="11sp"
            android:textColor="@color/widget_dark_secondary_text" />
    </LinearLayout>
</FrameLayout>
