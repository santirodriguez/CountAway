<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_background_horizon_dark"
        android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/time_widget_preview_title" android:fontFamily="sans-serif-medium"
            android:textSize="15sp" android:maxLines="2" android:textColor="@color/widget_dark_text" />
        <TextView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:gravity="center_vertical"
            android:text="79:12:05" android:fontFamily="sans-serif-condensed"
            android:textStyle="bold" android:textSize="38sp" android:textColor="@color/widget_dark_accent" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="end" android:text="@string/time_widget_preview_target"
            android:textSize="12sp" android:textColor="@color/widget_dark_secondary_text" />
    </LinearLayout>
</FrameLayout>
