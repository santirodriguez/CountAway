<?xml version="1.0" encoding="utf-8"?>
<com.santiagorodriguez.countaway.ui.HomeEventRow xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/surface_card_clickable"
    android:clipToPadding="false"
    android:minHeight="88dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/eventIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/icon_container"
        android:padding="11dp"
        android:scaleType="centerInside"
        android:tint="@color/accent" />

    <TextView
        android:id="@+id/eventTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:textColor="@color/foreground"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/eventMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:textColor="@color/secondary_text"
        android:textSize="13sp" />

    <View
        android:id="@+id/eventCountTile"
        android:layout_width="96dp"
        android:layout_height="80dp"
        android:background="@drawable/icon_container"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/eventArrival"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:visibility="gone" />

    <com.santiagorodriguez.countaway.ui.HomeCountTextView
        android:id="@+id/eventStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:minWidth="54dp"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:textColor="@color/accent_text"
        android:textSize="14sp" />

    <ImageButton
        android:id="@+id/eventActions"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/event_actions_label"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"
        android:paddingStart="32dp"
        android:paddingEnd="0dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_event_more"
        android:tint="@color/accent_text"
        android:visibility="gone" />
</com.santiagorodriguez.countaway.ui.HomeEventRow>
