<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CountAway" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/Theme.CountAway.Dialog.Alert</item>
        <item name="android:datePickerDialogTheme">@style/Theme.CountAway.Dialog.Alert</item>
    </style>

    <style name="Theme.CountAway.Dialog.Alert" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/foreground</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="android:windowBackground">@drawable/dialog_surface_background</item>
        <item name="android:windowElevation">14dp</item>
        <item name="android:textColorAlertDialogListItem">@color/foreground</item>
        <item name="android:listPreferredItemHeightSmall">48dp</item>
        <item name="android:buttonStyle">@style/Widget.CountAway.Dialog.Button</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Widget.CountAway.Dialog.Button</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Widget.CountAway.Dialog.Button</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/Widget.CountAway.Dialog.Button</item>
    </style>
</resources>
